# ---- Copy this file to ".env" and fill in your own values ----

# MongoDB. Use your own MongoDB Atlas connection string (same one as the Flask app).
# Leave BLANK to auto-use a zero-setup in-memory database for local testing.
MONGODB_URI=
MONGODB_DB=edupath_mern

# Secret used to sign login tokens (JWT). Put any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Admin console credentials (used at /admin)
ADMIN_USER=admin
ADMIN_PASS=admin123

# Where the Python ML service is running
ML_SERVICE_URL=http://127.0.0.1:8000

# The AI advisor. Leave LLM_PROVIDER=none to use the built-in rule-based advisor.
# For the real AI: set LLM_PROVIDER=groq and paste your free Groq key (gsk_...).
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# Port this backend listens on
PORT=5000

# Allowed frontend origin (the React dev server)
CLIENT_ORIGIN=http://127.0.0.1:5173
