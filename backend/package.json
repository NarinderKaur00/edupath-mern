{
  "name": "edupath-backend",
  "version": "1.0.0",
  "description": "EduPath MERN backend — auth, data (MongoDB), and the Groq AI advisor. Calls the Python ML service for predictions.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.8.3"
  },
  "optionalDependencies": {
    "mongodb-memory-server": "^10.1.2"
  }
}
